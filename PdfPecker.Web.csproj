<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The docs generator is a separate program; its sources and Markdown are not part of the site. nuget-seed holds
         packages CI hands to the Docker build (see the Dockerfile). -->
    <Compile Remove="tools/**;nuget-seed/**" />
    <Content Remove="tools/**;docs/**;nuget-seed/**" />
    <None Remove="tools/**;docs/**;nuget-seed/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published package from nuget.org; Dependabot opens a pull request when a new version is released. -->
    <PackageReference Include="PdfPecker" Version="1.21.0" />
  </ItemGroup>

</Project>
